    {
      "name": "task_get",
      "title": "Get task",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Task id: a T-number (T0–T9999) or a lowercase slug [a-z][a-z0-9-]; max 48 characters"
          }
        },
        "required": [
          "id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "task_create",
      "title": "Create task",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "One-line summary; non-empty, max 200 characters"
          },
          "id": {
            "type": "string",
            "description": "Task id: a T-number (T0–T9999) or a lowercase slug [a-z][a-z0-9-]; max 48 characters"
          },
          "spec": {
            "type": "string",
            "description": "Long-form goal/scope/acceptance criteria as markdown; max 20000 characters"
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in-progress",
              "blocked",
              "done",
              "cancelled"
            ]
          },
          "blockedReason": {
            "type": "string",
            "description": "Required when status is \"blocked\"; cleared automatically when leaving blocked"
          }
        },
        "required": [
          "title"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": null
    },
    {
      "name": "task_update",
      "title": "Update task",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Task id: a T-number (T0–T9999) or a lowercase slug [a-z][a-z0-9-]; max 48 characters"
          },
          "title": {
            "type": "string",
            "description": "One-line summary; non-empty, max 200 characters"
          },
          "spec": {
            "type": "string",
            "description": "Long-form goal/scope/acceptance criteria as markdown; max 20000 characters"
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in-progress",
              "blocked",
              "done",
