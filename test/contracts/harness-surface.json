{
  "tools": [
    {
      "name": "task_next",
      "title": "Next task to work on",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "task_list",
      "title": "List tasks",
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in-progress",
              "blocked",
              "done",
              "cancelled"
            ]
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "task_get",
      "title": "Get task",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Task id: a T-number (T0–T9999) or a lowercase slug [a-z][a-z0-9-]; max 48 characters"
          }
        },
        "required": [
          "id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "task_create",
      "title": "Create task",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "One-line summary; non-empty, max 200 characters"
          },
          "id": {
            "type": "string",
            "description": "Task id: a T-number (T0–T9999) or a lowercase slug [a-z][a-z0-9-]; max 48 characters"
          },
          "spec": {
            "type": "string",
            "description": "Long-form goal/scope/acceptance criteria as markdown; max 20000 characters"
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in-progress",
              "blocked",
              "done",
              "cancelled"
            ]
          },
          "blockedReason": {
            "type": "string",
            "description": "Required when status is \"blocked\"; cleared automatically when leaving blocked"
          }
        },
        "required": [
          "title"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": null
    },
    {
      "name": "task_update",
      "title": "Update task",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Task id: a T-number (T0–T9999) or a lowercase slug [a-z][a-z0-9-]; max 48 characters"
          },
          "title": {
            "type": "string",
            "description": "One-line summary; non-empty, max 200 characters"
          },
          "spec": {
            "type": "string",
            "description": "Long-form goal/scope/acceptance criteria as markdown; max 20000 characters"
          },
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in-progress",
              "blocked",
              "done",
              "cancelled"
            ]
          },
          "blockedReason": {
            "type": "string",
            "description": "Required when status is \"blocked\"; cleared automatically when leaving blocked"
          },
          "headSha": {
            "type": "string",
            "description": "Reviewed commit SHA used to prove the review matches the code being completed; max 200 characters"
          },
          "diffHash": {
            "type": "string",
            "description": "Reviewed diff fingerprint used to prove the worktree matches the review; max 200 characters"
          }
        },
        "required": [
          "id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": null
    },
    {
      "name": "task_delete",
      "title": "Delete task",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Task id: a T-number (T0–T9999) or a lowercase slug [a-z][a-z0-9-]; max 48 characters"
          },
          "force": {
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": null
    },
    {
      "name": "task_set_deps",
      "title": "Set task dependencies",
      "inputSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Task id: a T-number (T0–T9999) or a lowercase slug [a-z][a-z0-9-]; max 48 characters"
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string",
              "description": "Task id: a T-number (T0–T9999) or a lowercase slug [a-z][a-z0-9-]; max 48 characters"
            }
          }
        },
        "required": [
          "id",
          "dependsOn"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": null
    },
    {
      "name": "readiness_set",
      "title": "Record the pre-work readiness drill",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "description": "Task id: a T-number (T0-T9999) or a lowercase slug [a-z][a-z0-9-]; max 48 characters"
          },
          "goal": {
            "type": "string",
            "description": "One-line restatement of the task goal in your own words; max 500 chars"
          },
          "acceptance": {
            "type": "string",
            "description": "Verbatim quote of the task spec's acceptance criteria (whitespace-insensitive; at least 8 chars); max 4000 chars"
          },
          "serves": {
            "description": "Refs this task implements: R<n> plan requirement, D<n> decision, F<n> fact, T<n> task; max 20 entries of 120 chars",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outOfScope": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Explicit non-goals for this task (use [\"none\"] only if genuinely nothing is excluded); max 20 entries of 500 chars"
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Exact commands that will prove the work (e.g. \"pnpm test\", \"pnpm lint\"); max 20 entries of 500 chars"
          }
        },
        "required": [
          "taskId",
          "goal",
          "acceptance",
          "outOfScope",
          "commands"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": null
    },
    {
      "name": "readiness_get",
      "title": "Read the readiness drill",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "description": "Task id: a T-number (T0-T9999) or a lowercase slug [a-z][a-z0-9-]; max 48 characters"
          }
        },
        "required": [
          "taskId"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "session_log_add",
      "title": "Append session log line",
      "inputSchema": {
        "type": "object",
        "properties": {
          "session": {
            "type": "string",
            "description": "Short kebab-style session name; non-empty, max 80 characters"
          },
          "outcome": {
            "type": "string",
            "description": "One condensed line: what was done + resulting state; non-empty, max 300 characters"
          },
          "taskId": {
            "description": "Optional task id this session worked on (e.g. T3)",
            "type": "string"
          },
          "date": {
            "description": "UTC day as YYYY-MM-DD; defaults to today",
            "type": "string"
          }
        },
        "required": [
          "session",
          "outcome"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": null
    },
    {
      "name": "session_log_list",
      "title": "List session log",
      "inputSchema": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "session": {
            "type": "string"
          },
          "taskId": {
            "type": "string"
          }
        },
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "decision_append",
      "title": "Record decision",
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Concrete behavior name; non-empty, max 160 characters"
          },
          "body": {
            "type": "string",
            "description": "Binding rule + rationale/trade-off; non-empty, max 8000 characters"
          },
          "category": {
            "description": "Open short slug (api-facts, process, architecture, testing…); max 40 characters",
            "type": "string"
          },
          "taskId": {
            "description": "Optional task id this decision relates to (e.g. T3)",
            "type": "string"
          },
          "supersedes": {
            "description": "D-number of the decision this retires (e.g. D5)",
            "type": "string"
          }
        },
        "required": [
          "title",
          "body"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": null
    },
