            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "lens": {
                  "type": "string",
                  "enum": [
                    "correctness",
                    "security",
                    "data",
                    "tests",
                    "conventions",
                    "blast-radius",
                    "over-engineering",
                    "spec"
                  ]
                },
                "title": {
                  "type": "string",
                  "description": "Short finding title; max 200 chars"
                },
                "file": {
                  "type": "string",
                  "description": "File path"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991,
                  "description": "1-based line number"
                },
                "claim": {
                  "type": "string",
                  "description": "What is wrong, one sentence; max 1000 chars"
                },
                "failureMode": {
                  "type": "string",
                  "description": "Concrete state + input → wrong outcome; max 2000 chars"
                },
                "evidence": {
                  "type": "string",
                  "description": "Quoted code or command output; max 4000 chars"
                },
                "classKey": {
                  "description": "Bug class shared by other instances; max 80 chars",
                  "type": "string"
                },
                "fingerprint": {
                  "description": "Stable dedupe key; computed from lens/file/class/title when omitted",
                  "type": "string"
                },
                "severityHint": {
                  "description": "Initial severity hint, refined after refutation",
                  "type": "string",
                  "enum": [
                    "blocker",
                    "major",
                    "minor",
                    "nit"
                  ]
                },
                "introducedByDiff": {
                  "description": "False when the defect already exists on the base branch",
                  "type": "boolean"
                }
              },
              "required": [
                "lens",
                "title",
                "file",
                "line",
                "claim",
                "failureMode",
                "evidence"
