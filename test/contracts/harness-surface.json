    {
      "name": "fact_add",
      "title": "Record knowledge fact",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "gotcha",
              "api-fact",
              "insight",
              "note"
            ]
          },
          "title": {
            "type": "string",
            "description": "Short fact headline; non-empty, max 160 characters"
          },
          "body": {
            "type": "string",
            "description": "The observation itself; non-empty, max 8000 characters"
          },
          "origin": {
            "type": "string",
            "enum": [
              "user",
              "agent"
            ]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "taskId": {
            "type": "string"
          },
          "supersedes": {
            "type": "string"
          },
          "validFrom": {
            "type": "string"
          },
          "validTo": {
            "type": "string"
          },
          "links": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "rel": {
                  "type": "string",
                  "description": "Lowercase-hyphen relation slug; max 40 characters"
                },
                "dst": {
                  "type": "string",
                  "description": "Typed ref: fact:F1 | decision:D5 | task:T3 | plan:scope | entity:name"
                }
              },
              "required": [
                "rel",
                "dst"
              ]
            }
          }
        },
        "required": [
          "kind",
          "title",
          "body"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": null
