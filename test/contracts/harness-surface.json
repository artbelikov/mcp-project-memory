    {
      "name": "review_start",
      "title": "Start or advance a code review",
      "inputSchema": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "string",
            "description": "Task id to review"
          },
          "baseRef": {
            "description": "Base branch/ref the diff is measured from; max 200 chars",
            "type": "string"
          },
          "baseSha": {
            "description": "Base commit SHA",
            "type": "string"
          },
          "headSha": {
            "description": "Head commit SHA under review",
            "type": "string"
          },
          "diffHash": {
            "description": "Stable fingerprint of the reviewed diff",
            "type": "string"
          },
          "changedPaths": {
            "description": "Changed file paths; each max 500 chars",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "linesChanged": {
            "description": "Total added + removed lines, used to derive the risk tier",
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "risk": {
            "description": "Risk tier; derived from changedPaths when omitted",
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "exempt"
            ]
          },
          "oracle": {
            "description": "Quoted acceptance criteria/invariants read before the code; max 20000 chars",
            "type": "string"
          },
          "reviewer": {
            "description": "Reviewer identity: subagent id, model, or session label",
            "type": "string"
          },
          "freshContext": {
            "description": "True when the reviewer has no conversation history; required for medium/high risk",
            "type": "boolean"
          }
        },
        "required": [
          "taskId"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": null
    },
    {
      "name": "review_record_findings",
      "title": "Record review candidates",
      "inputSchema": {
        "type": "object",
        "properties": {
