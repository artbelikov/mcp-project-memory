    {
      "name": "fact_add",
      "title": "Record knowledge fact",
      "inputSchema": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "gotcha",
              "api-fact",
              "insight",
              "note"
            ]
          },
          "title": {
            "type": "string",
            "description": "Short fact headline; non-empty, max 160 characters"
          },
          "body": {
            "type": "string",
            "description": "The observation itself; non-empty, max 8000 characters"
          },
          "origin": {
            "type": "string",
            "enum": [
              "user",
              "agent"
            ]
