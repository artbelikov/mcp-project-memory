              "type": "object",
              "properties": {
                "rel": {
                  "type": "string",
                  "description": "Lowercase-hyphen relation slug; max 40 characters"
                },
                "dst": {
                  "type": "string",
                  "description": "Typed ref: fact:F1 | decision:D5 | task:T3 | plan:scope | entity:name"
                }
              },
              "required": [
                "rel",
                "dst"
              ]
            }
          }
        },
        "required": [
          "kind",
          "title",
          "body"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": null
