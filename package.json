{
  "name": "mcp-project-memory",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Universal AI task and plan execution harness: MCP server over a SQLite store (tasks, dependencies, decisions, session log, handoff, plan, knowledge base) plus the work-planning skill",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "skill:install": "node scripts/install-skill.mjs",
    "skill:check": "node scripts/install-skill.mjs --check"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "22.20.5",
    "fast-check": "^4.10.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
